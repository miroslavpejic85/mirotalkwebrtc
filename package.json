{
    "name": "mirotalkwebrtc",
    "version": "1.8.62",
    "description": "MiroTalk WebRTC admin",
    "main": "server.js",
    "scripts": {
        "start": "node backend/server.js",
        "dev": "node --watch backend/server.js",
        "env": "cp .env.template .env",
        "cfg": "cp backend/config.template.js backend/config.js",
        "mongo:up": "docker-compose -f docker-compose-mongo.yml up -d",
        "mongo:down": "docker-compose -f docker-compose-mongo.yml down",
        "mailpit:up": "docker-compose -f docker-compose-mailpit.yml up -d",
        "mailpit:down": "docker-compose -f docker-compose-mailpit.yml down",
        "test": "node --test \"test/**/*.test.js\"",
        "lint": "npx prettier --write .",
        "docker-build": "docker build --tag mirotalk/webrtc:latest .",
        "docker-rmi": "docker images |grep '<none>' |awk '{print $3}' |xargs docker rmi",
        "docker-push": "docker push mirotalk/webrtc:latest",
        "docker-pull": "docker pull mirotalk/webrtc:latest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/miroslavpejic85/mirotalkwebrtc"
    },
    "keywords": [
        "admin",
        "mongo",
        "webrtc",
        "nodejs",
        "express",
        "jwt"
    ],
    "author": "Miroslav Pejic",
    "license": "AGPL-3.0",
    "homepage": "https://github.com/miroslavpejic85/mirotalkwebrtc",
    "dependencies": {
        "@ngrok/ngrok": "1.7.0",
        "@sentry/node": "^11.6.0",
        "axios": "^1.20.0",
        "bcryptjs": "^3.0.3",
        "colors": "1.4.0",
        "compression": "^1.8.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "crypto-js": "^4.2.0",
        "dotenv": "^18.0.7",
        "express": "^5.3.0",
        "express-openid-connect": "^3.4.0",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "js-yaml": "^5.4.3",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.11.1",
        "nodemailer": "^10.0.16",
        "stripe": "^23.0.0",
        "swagger-ui-express": "^5.0.1",
        "twilio": "^6.1.2"
    },
    "devDependencies": {
        "prettier": "3.9.9"
    }
}
